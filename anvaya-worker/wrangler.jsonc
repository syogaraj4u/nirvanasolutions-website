{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anvaya-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-04",
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "anvaya.nirvanasolutions.in", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
